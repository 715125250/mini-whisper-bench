+// Limit the number of requests admitted to audio decoding / model execution.
+// The shared Whisper context is still protected by whisper_mutex below.
+constexpr int kMaxInflightRequests = 4;
+constexpr size_t kInferenceWorkerCount = 2;
+constexpr size_t kInferenceQueueCapacity = kMaxInflightRequests - kInferenceWorkerCount;
+std::atomic<int> g_inflight_requests{0};
+std::atomic<int> g_peak_inflight_requests{0};
+std::atomic<uint64_t> g_admitted_requests{0};
+std::atomic<uint64_t> g_overload_rejections{0};
+
+// A small bounded worker pool for request-side audio preparation and inference dispatch.
+// The shared Whisper context is still serialized by whisper_mutex while running the model.
+class BoundedThreadPool {
+public:
+    BoundedThreadPool(size_t worker_count, size_t queue_capacity)
+        : queue_capacity_(queue_capacity) {
+        workers_.reserve(worker_count);
+        for (size_t i = 0; i < worker_count; ++i) {
+            workers_.emplace_back([this] {
+                while (true) {
+                    std::function<void()> task;
+                    {
+                        std::unique_lock<std::mutex> lock(mutex_);
+                        condition_.wait(lock, [this] { return stopping_ || !tasks_.empty(); });
+                        if (stopping_ && tasks_.empty()) return;
+                        task = std::move(tasks_.front());
+                        tasks_.pop_front();
+                    }
+                    task();
+                }
+            });
+        }
+    }
+
+    BoundedThreadPool(const BoundedThreadPool &) = delete;
+    BoundedThreadPool & operator=(const BoundedThreadPool &) = delete;
+
+    ~BoundedThreadPool() { shutdown(); }
+
+    template <class F>
+    auto submit(F && function) -> std::future<typename std::invoke_result<F>::type> {
+        using result_type = typename std::invoke_result<F>::type;
+        auto task = std::make_shared<std::packaged_task<result_type()>>(std::forward<F>(function));
+        auto result = task->get_future();
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (stopping_) throw std::runtime_error("inference worker pool is stopping");
+            if (tasks_.size() >= queue_capacity_) throw std::runtime_error("inference worker queue is full");
+            tasks_.emplace_back([task] { (*task)(); });
+        }
+        condition_.notify_one();
+        return result;
+    }
+
+    void shutdown() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (stopping_) return;
+            stopping_ = true;
+        }
+        condition_.notify_all();
+        for (auto & worker : workers_) {
+            if (worker.joinable()) worker.join();
+        }
+    }
+
+private:
+    std::vector<std::thread> workers_;
+    std::deque<std::function<void()>> tasks_;
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    const size_t queue_capacity_;
+    bool stopping_ = false;
+};
+
+struct AdmissionGuard {
+    bool acquired = false;
+
+    AdmissionGuard() {
+        int current = g_inflight_requests.load(std::memory_order_relaxed);
+        while (current < kMaxInflightRequests) {
+            if (g_inflight_requests.compare_exchange_weak(
+                    current, current + 1, std::memory_order_acq_rel,
+                    std::memory_order_relaxed)) {
+                acquired = true;
+                ++g_admitted_requests;
+
+                int peak = g_peak_inflight_requests.load(std::memory_order_relaxed);
+                while (peak < current + 1 &&
+                       !g_peak_inflight_requests.compare_exchange_weak(
+                           peak, current + 1, std::memory_order_relaxed)) {}
+                return;
+            }
+        }
+        ++g_overload_rejections;
+    }
+
+    ~AdmissionGuard() {
+        if (acquired) --g_inflight_requests;
+    }
+};
